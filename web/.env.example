# Copy to .env (or .env.local) and fill in. Clerk's keys are written to .env.local by `npx clerk init`.

# GoingElectric API key: https://www.goingelectric.de/stromtankstellen/api/new/ (requires a login)
GE_API_KEY=

# The Ecurious test bay at the venue
# BAY_ID is its OCPI location_id: partner apps book it by this id, and its public page is /bay/<BAY_ID>
BAY_ID=ECU-TEST-1
BAY_NAME=Ecurious test bay
BAY_ADDRESS=Hackathon venue
BAY_LAT=52.52
BAY_LNG=13.405
BAY_POWER_KW=200
# fast (DC, sessions up to 2 h) or slow (AC, up to 4 h). Empty = from BAY_POWER_KW: 50 kW or more is fast
BAY_TYPE=

# Demo only: overrides the 15-min arrival grace before a no-show (fractions allowed: 0.5 = 30 s). Empty = 15 min
HOLD_MINUTES=

# Ecurious bay hardware (docs/hardware-integration.md). The real bay needs ECURIOUS_API_KEY *and* ECURIOUS_LIVE=1:
# the key alone doesn't go live. Anything else runs the built-in mock.
# The team's Ecurious server key, sent only in the X-API-Key header
ECURIOUS_API_KEY=
# 1 = commands move the real arm. Unset = the mock. The server refuses to start with SIMULATOR=1 as well
ECURIOUS_LIVE=
# 1 = always the mock, even with ECURIOUS_LIVE=1: the kill switch
ECURIOUS_MOCK=
# The bay at the venue (lock-0001 to lock-0003): match the serial printed on the device. Empty = the team's first bay
ECURIOUS_LOCK_ID=
# 1 = the booked plate goes on the camera's own plate list during a hold. Off until the phase-2 test confirms German plates
ECURIOUS_WHITELIST=
# How long the car sensor must read vacant before the car counts as gone, in ms
ECURIOUS_VACANT_MS=10000

# Required in the x-webhook-secret header of POST /api/plate-events. If empty, all plate events are rejected.
WEBHOOK_SECRET=

# 1 = show the camera simulator (dev only: anyone signed in can then fake a plate and open the bay).
# The server refuses to start with ECURIOUS_LIVE=1 as well: a faked plate would move the real arm
SIMULATOR=1

# Comma-separated emails of operator accounts: they get the operator dashboard and blocked-bay alert emails
OPERATOR_EMAILS=

# Resend API key for blocked-bay alert emails. Empty = alerts still show on the dashboard, emails are skipped.
# Until a domain is verified, Resend only delivers to the account's own email address.
RESEND_API_KEY=
ALERT_FROM=Ecurious Reserve <onboarding@resend.dev>

# Partner API for other charging apps (docs/api.md): name:token,… with lowercase names and tokens of 32+ characters
# (openssl rand -hex 32). List a name twice to rotate its token. Empty = the partner API is closed.
OCPI_PARTNER_TOKENS=
