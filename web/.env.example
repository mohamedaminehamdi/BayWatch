# Copy to .env (or .env.local) and fill in. Clerk's keys are written to .env.local by `npx clerk init`.

# GoingElectric API key: https://www.goingelectric.de/stromtankstellen/api/new/ (requires a login)
GE_API_KEY=

# The Ecurious test bay at the venue
BAY_NAME=Ecurious test bay
BAY_ADDRESS=Hackathon venue
BAY_LAT=52.52
BAY_LNG=13.405
BAY_POWER_KW=200

# How long a reservation holds the bay before it counts as a no-show
HOLD_MINUTES=15

# Required in the x-webhook-secret header of POST /api/plate-events. If empty, all plate events are rejected.
WEBHOOK_SECRET=

# 1 = show the camera simulator (dev only: anyone signed in can then fake a plate and open the bay)
SIMULATOR=1

# Comma-separated emails of operator accounts: they get the operator dashboard and blocked-bay alert emails
OPERATOR_EMAILS=

# Resend API key for blocked-bay alert emails. Empty = alerts still show on the dashboard, emails are skipped.
# Until a domain is verified, Resend only delivers to the account's own email address.
RESEND_API_KEY=
ALERT_FROM=Ecurious Reserve <onboarding@resend.dev>
