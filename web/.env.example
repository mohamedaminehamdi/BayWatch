# Copy to .env (or .env.local) and fill in. Clerk's keys are written to .env.local by `npx clerk init`.

# GoingElectric API key: https://www.goingelectric.de/stromtankstellen/api/new/ (requires a login).
# Every GoingElectric charger on the map is bookable, with a simulated guard
GE_API_KEY=

# The three Baywatch bays: bw-N:lock-NNNN, or bw-N: for a bay without hardware ("No hardware assigned yet").
# Locks the team doesn't have are dropped at start-up, and lock-0001 (not the team's any more) is never called
ECURIOUS_BAYS=bw-1:lock-0002,bw-2:lock-0003,bw-3:
# Where the Baywatch bays are (one every 6 m eastwards from this point) and their charger's power
BAY_ADDRESS=Hackathon venue
BAY_LAT=52.52
BAY_LNG=13.405
BAY_POWER_KW=200
# Dates priced as busy (YYYY-MM-DD, comma-separated), on top of weekday evenings 17:00–19:00
HOLIDAYS=

# Ecurious lock hardware (docs/hardware-integration.md). Real locks move only with ECURIOUS_API_KEY *and*
# ECURIOUS_LIVE=1: the key alone doesn't go live. Anything else runs the built-in mock.
# The team's Ecurious server key, sent only in the X-API-Key header
ECURIOUS_API_KEY=
# 1 = bookings on bays with a lock move the real arm. Unset = the mock
ECURIOUS_LIVE=
# 1 = always the mock, even with ECURIOUS_LIVE=1: the kill switch
ECURIOUS_MOCK=
# The lock that single-bay calls mean (the CLI, the old single-bay pages). It must be one of the team's locks.
# Empty = none: there's no fallback guess

ECURIOUS_LOCK_ID=
# The camera's own plate list is ON by default: the booked plate goes on it when the arm rises, and it's
# cleared at the end. 0 = off (the list stays empty and our own plate match lowers the arm)
ECURIOUS_WHITELIST=
# How long the car sensor must read vacant before the car counts as gone, in ms
ECURIOUS_VACANT_MS=10000

# Required in the x-webhook-secret header of POST /api/plate-events. If empty, all plate events are rejected.
WEBHOOK_SECRET=

# 1 = the demo panel (fake plates, a car in a simulated bay, site demand, "Simulate a week"). Allowed next to
# live hardware: demo events are refused (403) for bays with a real lock, which only listen to their own camera
SIMULATOR=1

# Comma-separated emails of operator accounts: they get the operator dashboard and blocked-bay alert emails
OPERATOR_EMAILS=

# Resend API key for blocked-bay alert emails. Empty = alerts still show on the dashboard, emails are skipped.
# Until a domain is verified, Resend only delivers to the account's own email address.
RESEND_API_KEY=
ALERT_FROM=Baywatch <onboarding@resend.dev>

# Partner API for other charging apps (docs/api.md): name:token,… with lowercase names and tokens of 32+ characters
# (openssl rand -hex 32). List a name twice to rotate its token. Empty = the partner API is closed.
OCPI_PARTNER_TOKENS=

# Card payments, Stripe TEST MODE only (docs/payments.md). Both keys, from the same mode, or neither: without them
# the app takes demo payments. A live key is refused unless STRIPE_ALLOW_LIVE=1. Not yet wired into booking v2
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Voice booking (docs/voice-booking.md). Payment is simulated, so it only runs with VOICE_DEMO=1 (off by default).
VOICE_DEMO=
# Bearer token Vapi sends to /api/voice/vapi (its Bearer Token credential holds the same). Empty = every call rejected.
VAPI_BEARER_SECRET=
# Keys the app mic's 15-minute session tokens. Server only: never give it to Vapi. Empty = the mic can't start a call.
VOICE_SESSION_SECRET=
# Optional: the Clerk user id phone calls book for (they carry no session token). Empty = phone callers are sent to the app.
VOICE_DEMO_USER_ID=
# The in-app mic button shows only when both are set (Vapi dashboard: public key, assistant id)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
